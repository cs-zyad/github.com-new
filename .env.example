# قاعدة البيانات — SQLite للتشغيل المحلي والتجربة (connection_limit=1 يجعل العمليات الحرجة متسلسلة داخل العملية)
DATABASE_URL="file:./dev.db?connection_limit=1"

# الرابط الأساسي للمنصة (يُستخدم في روابط الدعوات والرسائل)
APP_URL="http://localhost:3000"

# الوضع التجريبي: يفعّل صندوق الرسائل التجريبي وصفحة الدفع التجريبية
DEMO_MODE="true"

# مزوّدو الربط (mock = تجريبي). تُحدَّد المزوّدات الفعلية لاحقًا.
WHATSAPP_PROVIDER="mock"
EMAIL_PROVIDER="mock"
PAYMENT_PROVIDER="mock"

# سر توقيع إشعارات الدفع (غيّره في الإنتاج)
PAYMENT_WEBHOOK_SECRET="change-me-payment-webhook-secret"

# سر استدعاء المهام المجدولة من خدمة cron خارجية: GET /api/cron?key=...
CRON_SECRET="change-me-cron-secret"

# تشغيل عامل المهام داخل خادم Next (التذكيرات المجدولة وطابور الرسائل)
RUN_WORKER="true"
