# ───── Firebase (قاعدة البيانات: Firestore) ─────
# للإنتاج/Vercel: محتوى ملف حساب الخدمة JSON كما هو (أو مرمّزًا base64)
# Firebase Console ← Project settings ← Service accounts ← Generate new private key
FIREBASE_SERVICE_ACCOUNT=""
# بديل: ثلاثة متغيرات منفصلة
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# للتطوير المحلي بدون حساب: npm run dev:local يشغّل محاكي Firestore ويضبط هذا تلقائيًا
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8085"

# الرابط الأساسي للمنصة (روابط الدعوات والرسائل). على Vercel يُستنتج تلقائيًا إن تُرك فارغًا
APP_URL="http://localhost:3000"

# الوضع التجريبي: صندوق رسائل تجريبي، صفحة دفع تجريبية، وبيانات تجريبية عند البناء
DEMO_MODE="true"

# مزوّدو الربط (mock = تجريبي). تُحدَّد المزوّدات الفعلية لاحقًا.
WHATSAPP_PROVIDER="mock"
EMAIL_PROVIDER="mock"
PAYMENT_PROVIDER="mock"

# سر توقيع إشعارات الدفع (غيّره في الإنتاج)
PAYMENT_WEBHOOK_SECRET="change-me-payment-webhook-secret"

# سر استدعاء المهام المجدولة: Vercel Cron يرسله تلقائيًا، أو GET /api/cron?key=...
CRON_SECRET="change-me-cron-secret"

# تشغيل عامل المهام داخل خادم Next (غير مستخدم على Vercel — هناك Vercel Cron)
RUN_WORKER="true"
