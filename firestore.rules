rules_version = '2';
// المنصة تقرأ وتكتب من الخادم فقط عبر firebase-admin (يتجاوز هذه القواعد).
// لذلك نمنع أي وصول مباشر من المتصفحات أو التطبيقات للقاعدة.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
